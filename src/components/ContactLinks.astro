---
import { site } from '../site.config';

const links = site.links.filter(link => link.url).map(link => ({ ...link, icon: link.icon ?? 'link' }));
---
<nav class="contact-links" aria-label="Contact links">
  {links.map(link => <a href={link.url} aria-label={link.label} title={link.label} data-icon={link.icon} target={link.url.startsWith('mailto:') ? undefined : '_blank'} rel={link.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}>
    {link.icon === 'mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m4 7 8 6 8-6" /></svg>}
    {link.icon === 'github' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-2.7 16.56c.43.08.59-.18.59-.41v-1.6c-2.4.52-2.91-1.02-2.91-1.02-.39-.99-.95-1.25-.95-1.25-.78-.53.06-.52.06-.52.86.06 1.31.88 1.31.88.77 1.3 2.02.92 2.52.7.08-.55.3-.92.55-1.13-1.92-.22-3.94-.96-3.94-4.28 0-.95.34-1.72.88-2.33-.09-.22-.38-1.1.08-2.3 0 0 .72-.23 2.35.89A8.2 8.2 0 0 1 12 7.4c.73 0 1.47.1 2.16.29 1.63-1.12 2.35-.89 2.35-.89.46 1.2.17 2.08.08 2.3.55.61.88 1.38.88 2.33 0 3.33-2.02 4.06-3.95 4.28.31.27.59.79.59 1.6v2.34c0 .23.16.5.6.41A8.5 8.5 0 0 0 12 3.5Z" /></svg>}
    {link.icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 3h-15A1.5 1.5 0 0 0 3 4.5v15A1.5 1.5 0 0 0 4.5 21h15a1.5 1.5 0 0 0 1.5-1.5v-15A1.5 1.5 0 0 0 19.5 3ZM8.34 18H5.66V9.37h2.68V18ZM7 8.19a1.56 1.56 0 1 1 0-3.12 1.56 1.56 0 0 1 0 3.12ZM18.38 18H15.7v-4.2c0-1-.02-2.3-1.4-2.3-1.41 0-1.63 1.1-1.63 2.23V18H10v-8.63h2.57v1.18h.04c.36-.68 1.23-1.4 2.53-1.4 2.7 0 3.2 1.78 3.2 4.1V18Z" /></svg>}
    {link.icon === 'link' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 13.5a4 4 0 0 0 5.66.01l2-2a4 4 0 0 0-5.66-5.66l-1.15 1.15M13.5 10.5a4 4 0 0 0-5.66-.01l-2 2a4 4 0 0 0 5.66 5.66l1.15-1.15" /></svg>}
  </a>)}
</nav>
