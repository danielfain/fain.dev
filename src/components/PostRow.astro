---
import { withBase } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
import Arrow from './Arrow.astro';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
---
<article class="post-row">
  <div class="post-date mono"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{post.data.category}</span></div>
  <div class="post-copy">
    <h3><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}<span class="post-arrow"><Arrow diagonal /></span></a></h3>
    <p>{post.data.description}</p>
    {post.data.sample && <span class="sample-label mono">Example article</span>}
  </div>
</article>
