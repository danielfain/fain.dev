---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="Page not found">
  <section class="page-intro not-found"><p class="eyebrow">404 / A SMALL DETOUR</p><h1>Nothing here.<br /><em>Plenty elsewhere.</em></h1><p>This page may have moved, or the link may have a typo.</p><a class="text-link" href={withBase('/')}>Head back home <Arrow /></a></section>
</BaseLayout>
