---
import { withBase } from '../../lib/url';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { publishedPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class="article-page">
    <a class="text-link back-link" href={withBase('/blog/')}><Arrow />Back to the notebook</a>
    <header class="article-header"><div class="article-meta mono"><span>{post.data.category}</span><span aria-hidden="true">/</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p>{post.data.sample && <p class="content-notice">Example article · Written to demonstrate the blog layout.</p>}</header>
    <div class="prose"><Content /></div>
    <div class="article-end"><span class="end-mark" aria-hidden="true">✳</span><a class="text-link" href={withBase('/blog/')}>More from the notebook <Arrow /></a></div>
  </article>
</BaseLayout>
