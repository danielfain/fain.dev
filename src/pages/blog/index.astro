---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { publishedPosts } from '../../lib/content';
const posts = await publishedPosts();
---
<BaseLayout title="Writing" description="Notes on software development, thoughtful design, and learning by doing.">
  <section class="page-intro"><h1>My <em>writing.</em></h1><p>Things I’ve learned, questions I’m sitting with, and notes I want to come back to.</p></section>
  <section class="collection-section" aria-label="All articles"><div class="post-list">{posts.length ? posts.map(post => <PostRow post={post} />) : <p class="empty-state">Nothing published just yet.</p>}</div></section>
</BaseLayout>
