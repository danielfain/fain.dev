---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import { publishedPosts, publishedProjects } from '../lib/content';
import { site } from '../site.config';
import ContactLinks from '../components/ContactLinks.astro';
const projects = (await publishedProjects()).filter(project => project.data.featuredOrder !== undefined).slice(0, 3);
const posts = (await publishedPosts())
  .filter(post => post.data.favoriteOrder !== undefined)
  .sort((a, b) => a.data.favoriteOrder! - b.data.favoriteOrder!)
  .slice(0, 3);
---
<BaseLayout title="Home">
  <section class="welcome" aria-labelledby="welcome-title">
    <div class="welcome-copy">
      <h1 id="welcome-title">Hi, I’m <em>{site.name}.</em></h1>
      <p class="welcome-intro">{site.introduction}</p>
      <ContactLinks />
    </div>
  </section>
  <section class="section-block writing-section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Favorite articles</h2><a class="text-link" href={withBase('/blog/')}>All posts <Arrow /></a></div>
    <div class="post-list">{posts.length ? posts.map(post => <PostRow post={post} />) : <p class="empty-state">Nothing published just yet.</p>}</div>
  </section>
  <section id="selected-work" class="section-block" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">Selected work</h2><a class="text-link" href={withBase('/projects/')}>All projects <Arrow /></a></div>
    {projects.length ? <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div> : <p class="empty-state">Nothing to share here just yet.</p>}
  </section>
</BaseLayout>
